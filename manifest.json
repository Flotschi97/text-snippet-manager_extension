{
  "manifest_version": 3,
  "name": "Text Snippet Manager",
  "version": "2.0",
  "description": "Save, organize, and quickly copy your frequently used text snippets and templates.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}